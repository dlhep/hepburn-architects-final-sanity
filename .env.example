# Public Sanity connection
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production

# Used only for instant revalidation webhook
SANITY_REVALIDATE_SECRET=create-a-long-random-secret

# One-time local import only; do not expose publicly or keep after migration
SANITY_API_WRITE_TOKEN=

# Automatic Project Map geocoding webhook (server only)
SANITY_MAP_GEOCODING_SECRET=
SANITY_MAP_WRITE_TOKEN=
GOOGLE_MAPS_GEOCODING_API_KEY=
CRON_SECRET=

# Official Google Business Profile review synchronisation (server only)
# OAuth web/desktop client credentials approved for the Business Profile APIs.
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
# Long-lived OAuth refresh token with the business.manage scope.
GOOGLE_BUSINESS_REFRESH_TOKEN=
# Resource identifiers from the authenticated Business Profile account.
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_BIRMINGHAM_LOCATION_ID=
GOOGLE_BUSINESS_NORTH_EAST_LOCATION_ID=
# Sanity Editor token restricted to writing review documents.
SANITY_REVIEW_SYNC_TOKEN=
# Explicit editorial/legal switch. Use true only after approving public republication.
ALLOW_PUBLIC_GOOGLE_REVIEW_SYNC=false

# Optional website analytics and advertising destinations
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
